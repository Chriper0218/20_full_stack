# Archivo de ejemplo para las variables de entorno
# Copia este archivo como .env y rellena los valores

# URL de conexión a la base de datos PostgreSQL (Neon u otro proveedor)
DATABASE_URL="postgresql://usuario:contraseña@host:puerto/basededatos?sslmode=require"

# Secreto para firmar los JSON Web Tokens
JWT_SECRET="super_secret_key_change_me_in_production"

# Llave de la compañía para el registro de empleados (coincide con prisma/seed.ts)
COMPANY_KEY="CUC-2026"
